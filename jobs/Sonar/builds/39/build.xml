    <result>SUCCESS</result>
    <script>pipeline {
    agent any
    
    tools {
        maven &apos;maven3.9&apos;
        jdk &apos;jdk17&apos;
    }
    
    environment{
        SCANNER_HOME = tool &apos;sonar-scanner&apos;
    }

    stages {
        stage(&apos;Git Checkout&apos;) {
            steps {
                git branch: &apos;main&apos;, url: &apos;https://github.com/sandhya-en/Boardgame.git&apos;
            }
        }
         stage(&apos;Compile&apos;) {
            steps {
                echo &apos;mvn compile&apos;
            }
        }
         stage(&apos;Test&apos;) {
            steps {
                echo &apos;mvn test&apos;
            }
        }
        
        stage(&apos;Build&apos;) {
            steps {
                echo &apos;mvn clean package&apos;
            }
        }
        
        stage(&apos;SonarQube Analysis&apos;) {
            steps {
                withSonarQubeEnv(&apos;sonarqube&apos;){
                    sh &apos;&apos;&apos; $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectname=BoardGame\
                             -Dsonar.projectkey=Boardgame -Dsonar.java.binaries=target&apos;&apos;&apos;
                }
            }
        }
        stage(&apos;Quality-Gate&apos;) {
            steps {
                timeout(time: 1, unit: &apos;HOURS&apos;) {
                waitForQualityGate abortPipeline: false, credentialsId: &apos;sonarqube-cred&apos;
            }
        
        }
    }
}
}</script>
